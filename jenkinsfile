pipeline {
    agent {
        node {
            label "slave"
        }
    }
    tools{
        maven "jenkins-maven"
    }

    stages{
        stage("test"){
            steps{
                sh 'mvn test'
            }
        }

        stage("build"){
            steps{
                sh 'mvn package'
            }
        }

        stage("testing locally"){
            steps{
                deploy adapters: [tomcat9(alternativeDeploymentContext: '', credentialsId: 'tomcat-access', path: '', url: 'http://192.168.247.145:8082')], contextPath: '/hello-world-0.0.1-SNAPSHOT/ ', war: '**/*.war'
            }
        }

        stage("deploy to prod"){
            input{
                message "did we continue"
                ok "yes continue"
            }
            steps{
                deploy adapters: [tomcat9(alternativeDeploymentContext: '', credentialsId: 'tomcat-access', path: '', url: 'http://192.168.247.143:8082')], contextPath: '/hello-world-0.0.1-SNAPSHOT/ ', war: '**/*.war'
            }
        }
    }
    post{
        always{
            echo "pipeline ends"
        }
        failure{
            echo "pipeline failed"
        }
        success{
            echo "pipeline sucessfull"
        }
    }
}
